{
  "name": "@sandsoftwaresolutions/msg-format",
  "version": "0.1.1",
  "description": "ICU MessageFormat at runtime: plurals, select, ordinals, numbers, dates and tags in any language, with errors that say where.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "icu",
    "messageformat",
    "i18n",
    "plural",
    "translation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-msg-format.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-msg-format/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-msg-format#readme",
  "publishConfig": {
    "access": "public"
  }
}
